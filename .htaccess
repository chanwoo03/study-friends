# 설정·서버 코드·세션 파일을 브라우저에서 직접 열 수 없게 막기
<FilesMatch "^(config\.php|config\.sample\.php|schema\.sql|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes

# 화면 파일은 매번 새 버전인지 확인 (업데이트 후 예전 파일이 섞여 화면이 깨지는 것을 막아요)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html|webmanifest|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
