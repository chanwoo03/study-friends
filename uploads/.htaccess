# 올린 사진만 보여 주고, 프로그램 파일은 절대 실행하지 않아요
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|htaccess|html?|js|svg)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
